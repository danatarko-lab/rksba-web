         <pdf:Keywords>WAVE; WAVE Work Group Communications; advanced desktop communicator; WAVE dispatch; dispatch; push-to-talk; PTT</pdf:Keywords>
         <pdf:Producer>Adobe PDF Library 10.0.1</pdf:Producer>
         <pdf:Trapped>false</pdf:Trapped>
         <xmp:CreatorTool>Adobe InDesign CS6 (Windows)</xmp:CreatorTool>
         <xmp:MetadataDate>2016-03-09T13:33:26.000Z</xmp:MetadataDate>
         <xmp:ModifyDate>2016-03-09T08:33:26.000-05:00</xmp:ModifyDate>
         <xmp:CreateDate>2016-03-09T08:33:22.000-05:00</xmp:CreateDate>
         <dc:format>application/pdf</dc:format>
         <dc:modified>2016-05-04T06:51:38.371-04:00</dc:modified>
         <dc:creator>
            <rdf:Alt>
               <rdf:li>Motorola Solutions</rdf:li>
            </rdf:Alt>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The WAVE Advanced Desktop Communicator is a powerful software application designed to provide many of the capabilities associated with dispatch consoles deployed for mission-critical public safety, military and critical infrastructure organizations. Using a laptop computer and a microphone-equipped headset, an Advanced Desktop Communicator lets the operator create and manage a large number of communications channels, create and tear down patches between channels, manage user access to Channels, access radio alarms and use radio IDs to identify individual radios and users.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>WAVE</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">WAVE Advanced Desktop Communicator Data Sheet</rdf:li>
            </rdf:Alt>
         </dc:title>
