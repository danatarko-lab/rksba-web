         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Extend push-to-talk (PTT) communication by enabling Android and Apple iOS devices to instantly communicate with two-way radio and other broadband users. </rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>WAVE</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">WAVE Mobile Communicator Data Sheet</rdf:li>
            </rdf:Alt>
         </dc:title>
         <pdf:Keywords>WAVE; PTT; smartphone; android; ios; iphone; apple; Interoperability; Voice; Communications; push-to-talk; push; to; talk; interoperable; broadband; mototrbo; work group communications; tablet; desktop; secure; enterprise; workgroup; chat; app; two-way radios; harris; eschat; tait; kodiak; beon</pdf:Keywords>
