         <dc:format>application/pdf</dc:format>
         <dc:modified>2015-06-04T04:13:44.377-04:00</dc:modified>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>SLR 5000</rdf:li>
               <rdf:li>MOTOTRBO</rdf:li>
               <rdf:li>DMR</rdf:li>
               <rdf:li>Capacity Plus</rdf:li>
               <rdf:li>repeater</rdf:li>
               <rdf:li>two-way radio</rdf:li>
               <rdf:li>For your business to be successful, you need dependable voice and data communications that reach every corner of your operations. The MOTOTRBO SLR 5000 Series repeater delivers high performance, high reliability two-way radio service with all the features you need to connect your workplace. </rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">For your business to be successful, you need dependable voice and data communications that reach every corner of your operations. The MOTOTRBO SLR 5000 Series repeater delivers high performance, high reliability two-way radio service with all the features you need to connect your workplace. </rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Alt>
               <rdf:li>Motorola Solutions</rdf:li>
               <rdf:li>Inc.</rdf:li>
            </rdf:Alt>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MOTOTRBO SLR 5500 Series Repeater Data Sheet</rdf:li>
            </rdf:Alt>
         </dc:title>
