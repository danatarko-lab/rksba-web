            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Norwayâ€™s national stadium improves fansâ€™ experiences with Motorola Solutionsâ€™ safety and security ecosystem</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Motorola Solutions</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Ullevaal Stadion has deployed Motorola Solutionsâ€™ safety and security ecosystem, comprising MOTOTRBO Capacity Plus, a range of MOTOTRBO radios and WAVE PTX radios, body cameras and an Avigilon video system. The stadium is also looking to introduce further technologies soon. The ecosystem is boosting safety and security for the stadium, whilst significantly easing workload for the team</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Motorola Solutions</rdf:li>
               <rdf:li>Motorola</rdf:li>
               <rdf:li>Ullevaal Stadion</rdf:li>
               <rdf:li>Ullevaal Stadium</rdf:li>
               <rdf:li>Norakom</rdf:li>
               <rdf:li>NORAKOMÂ® (Norsk Radiokommunikasjon AS)</rdf:li>
               <rdf:li>Motorola Solutions solving for safer</rdf:li>
               <rdf:li>solving for safer</rdf:li>
               <rdf:li>Motorola Solutions solving for safer safety and security ecosystem</rdf:li>
               <rdf:li>people and technology are stronger united</rdf:li>
               <rdf:li>we build and connect technologies to help protect people</rdf:li>
               <rdf:li>property and places</rdf:li>
               <rdf:li>enabling critical collaboration between public safety agencies and enterprises for a proactive approach to safety and security</rdf:li>
               <rdf:li>solving for safer for stadiums</rdf:li>
               <rdf:li>solving for safer for sports and leisure</rdf:li>
               <rdf:li>solving for safer for conferences</rdf:li>
               <rdf:li>MOTOTRBO Capacity Plus multi-site</rdf:li>
               <rdf:li>SLR 5500 two-way repeaters</rdf:li>
               <rdf:li>MOTOTRBO two-way radios</rdf:li>
               <rdf:li>Ion</rdf:li>
               <rdf:li>SL4000e</rdf:li>
               <rdf:li>DP3441e</rdf:li>
               <rdf:li>DP4801e</rdf:li>
               <rdf:li>DP4601e</rdf:li>
               <rdf:li>DP2400e</rdf:li>
               <rdf:li>R7</rdf:li>
               <rdf:li>WAVE PTX</rdf:li>
               <rdf:li>TLK 100</rdf:li>
               <rdf:li>TLK 25 radios</rdf:li>
               <rdf:li>WAVE PTX mobile application</rdf:li>
               <rdf:li>Evolve LTE handhelds</rdf:li>
               <rdf:li>VB400 body cameras</rdf:li>
               <rdf:li>Avigilon security cameras</rdf:li>
               <rdf:li>Avigilon H3</rdf:li>
               <rdf:li>Avigilon H4</rdf:li>
               <rdf:li>Avigilon H5</rdf:li>
               <rdf:li>Avigilon H6</rdf:li>
               <rdf:li>Avigilon PTZ cameras</rdf:li>
               <rdf:li>Avigilon fixed dome cameras</rdf:li>
               <rdf:li>Avigilon bullet cameras</rdf:li>
               <rdf:li>Avigilon Pro cameras</rdf:li>
               <rdf:li>Avigilon Unity Video 8</rdf:li>
               <rdf:li>Radio Alert</rdf:li>
               <rdf:li>SmartPTT control room solution</rdf:li>
               <rdf:li>Avigilon Unusual Motion Detection</rdf:li>
               <rdf:li>Avigilon UMD</rdf:li>
               <rdf:li>Avigilon Unusual Activity Detection</rdf:li>
               <rdf:li>Avigilon UAD</rdf:li>
               <rdf:li>self-learning video analytics</rdf:li>
               <rdf:li>Motorola Solutions charger</rdf:li>
               <rdf:li>Motorola Solutions accessories</rdf:li>
               <rdf:li>Motorola Solutions Access Control</rdf:li>
               <rdf:li>Alta Access Control</rdf:li>
               <rdf:li>Motorola Solutions drone software</rdf:li>
               <rdf:li>CAPE drone video and flight control software</rdf:li>
               <rdf:li>ONVIF</rdf:li>
               <rdf:li>Motorola Solutions Orchestrate</rdf:li>
               <rdf:li>Orchestrate workflow automation tool</rdf:li>
            </rdf:Bag>
