         <ns1:sha1>c9274842137aa24132245c47559572f606943b2e</ns1:sha1>
         <ns1:size>330070</ns1:size>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Motorola Solutions</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:format>application/pdf</dc:format>
         <dc:modified>2016-07-26T18:46:04.877Z</dc:modified>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">With the support of UNSOM, the Mogadishu Police Force has installed a dedicated two-way digital radio network for 200 police officers. The secure, reliable system provides coverage where officers need it across the capital with reliable, crystal clear voice calls and data services including GPS tracking of officers. Motorola Solutions designed, tested and installed the system and is now training local teams to look after the network. </rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Motorola Solutions</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Mogadishu Police, Somalia Use MOTOTRBOâ„¢ To Optimise Officer Safety With Reliable, Secure And Efficient Voice And Data Communications</rdf:li>
            </rdf:Alt>
         </dc:title>
         <pdf:Keywords>Motorola Solutions; UNSOM; Somalia Police Force; AMISOM; MOTOTRBO; digital two-way radios; TRBOnet; GPS tracking; clear audio calls; optimising safety with two-way radios; Radio Communications for Mogadishu; MOTOTRBO Police Force</pdf:Keywords>
         <pdf:Producer>Adobe PDF Library 15.0</pdf:Producer>
         <pdf:Trapped>false</pdf:Trapped>
