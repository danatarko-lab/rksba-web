            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Leading Spanish motor racing Circuit boosts efficiency, safety and security with MOTOTRBO Capacity Plus</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Motorola Solutions</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">In line with its recent modernisation, the Circuit de Bareclona-Cataluyna has worked with Motorola Solutions partner, Expocom, to deploy a MOTOTRBO Capacity Plus radio system at its track. The deployment is delivering reliable, secure communications, optimal audio and a range of added functionality which is boosting productivity and efficiency</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Motorola Solutions</rdf:li>
               <rdf:li>Motorola</rdf:li>
               <rdf:li>Circuit de Barcelona-Cataluyna</rdf:li>
               <rdf:li>Expocom S.A.</rdf:li>
               <rdf:li>Expocom</rdf:li>
               <rdf:li>MOTOTRBO Capacity Plus system</rdf:li>
               <rdf:li>MOTOTRBO for motor racing circuits</rdf:li>
               <rdf:li>what are the best radio systems for motor racing</rdf:li>
               <rdf:li>what are the best radio systems for motor racing circuits</rdf:li>
               <rdf:li>Motorola Solutions in Spain</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <xmp:CreateDate>2024-06-25T15:19:07+01:00</xmp:CreateDate>
