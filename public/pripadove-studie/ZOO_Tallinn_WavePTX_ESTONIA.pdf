         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">WAVE PTXâ„¢ BYOD solution drives safety and efficiency at Tallinn Zoo</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Motorola Solutions</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Tallinn Zoo in Estonia has deployed the WAVE PTX broadband service push-to-talk mobile app on its staffâ€™s existing smartphones for reliable, instant communications. The improved team coordination is boosting safety, efficiency and productivity at the zoo</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Motorola Solutions</rdf:li>
               <rdf:li>Motorola</rdf:li>
               <rdf:li>Tallinn Zoo</rdf:li>
               <rdf:li>DAN Communications</rdf:li>
               <rdf:li>WAVE PTX</rdf:li>
               <rdf:li>WAVE PTX mobile app</rdf:li>
               <rdf:li>WAVE PTX App</rdf:li>
               <rdf:li>WAVE PTX BYOD solution</rdf:li>
               <rdf:li>WAVE PTX portal</rdf:li>
               <rdf:li>best radio communications systems for zoos</rdf:li>
               <rdf:li>broadband PTT solutions for tourism</rdf:li>
               <rdf:li>Motorola Solutions in Estonia</rdf:li>
               <rdf:li>what radio system does Tallinn Zoo use?</rdf:li>
            </rdf:Bag>
         </dc:subject>
