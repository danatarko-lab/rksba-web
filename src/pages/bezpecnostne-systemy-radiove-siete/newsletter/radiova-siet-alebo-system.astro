          <text x="588" y="66" font-family="Arial" font-size="11.5" fill="#5b6677" text-anchor="middle">riadenie a dáta</text>

          <line x1="481" y1="58" x2="481" y2="252" stroke="#9aa7b5" stroke-width="1" stroke-dasharray="4 4"></line>

          <rect x="40" y="92" width="138" height="62" rx="4" fill="#9db4e8"></rect>
