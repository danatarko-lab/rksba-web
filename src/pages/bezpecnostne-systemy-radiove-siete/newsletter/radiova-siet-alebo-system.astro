          <text x="214" y="61" font-family="Arial" font-size="12.5" font-weight="700" fill="#5E6B78">500–1 000 €</text>
          <text x="12" y="109" font-family="Arial" font-size="12.5" font-weight="700" fill="#0B1F3A">Rádiová lokalita</text>
          <rect x="200" y="90" width="24" height="26" rx="2" fill="#1A1ADB"></rect>
