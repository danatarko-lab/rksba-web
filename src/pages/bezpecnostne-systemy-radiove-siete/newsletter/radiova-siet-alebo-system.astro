          <rect x="326" y="92" width="150" height="62" rx="4" fill="#1A1ADB"></rect>
          <text x="401" y="124" font-family="Arial" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">Viac lokalít /</text>
          <text x="401" y="138" font-family="Arial" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">trunking</text>
          <rect x="486" y="92" width="204" height="62" rx="4" fill="#0B1F3A"></rect>
          <text x="588" y="124" font-family="Arial" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">Dispečing · dáta ·</text>
          <text x="588" y="138" font-family="Arial" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">bezpečnosť</text>

          <text x="109" y="178" font-family="Arial" font-size="11" fill="#5b6677" text-anchor="middle">priama komunikácia</text>
          <text x="252" y="178" font-family="Arial" font-size="11" fill="#5b6677" text-anchor="middle">pokrytie + kapacita</text>
          <text x="401" y="178" font-family="Arial" font-size="11" fill="#5b6677" text-anchor="middle">roaming, súbežnosť</text>
