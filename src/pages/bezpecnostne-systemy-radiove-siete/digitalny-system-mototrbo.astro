---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import heroMototrbo from '~/assets/images/radiokomunikacie/battery-impres-07.webp';

const metadata = {
  title: 'Digitálny systém MOTOTRBO: profesionálne DMR siete | RKS',
  description:
    'Digitálny systém Motorola MOTOTRBO: spoľahlivá hlasová komunikácia, GPS lokalizácia, šifrovanie, dispečing a správa rádiových sietí pre firmy a organizácie. Návrh, dodávka, konfigurácia, servis.',
};

const faqs = [
  {
    q: 'Čo je MOTOTRBO?',
    a: 'Digitálny komunikačný systém Motorola na medzinárodnom štandarde DMR.',
  },
  {
    q: 'Dá sa prejsť z analógu na MOTOTRBO?',
    a: 'Áno. Modernizáciu možno realizovať postupne podľa potrieb organizácie.',
  },
  {
    q: 'Dá sa komunikácia šifrovať?',
    a: 'Áno. MOTOTRBO podporuje viac úrovní šifrovania.',
  },
];

// Systemove architektury MOTOTRBO (od zakladov po najvacsie trunkove systemy)
const architektury = [
  {
    title: 'Digitálna technológia DMR',
    desc: 'Ako funguje digitálny prenos, TDMA a triedy DMR Tier I až III.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-dmr-technologia',
  },
  {
    title: 'Priame spojenie',
    desc: 'Najjednoduchšie riešenie pre jednu lokalitu do 100 rádiostaníc.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-priame-spojenie',
  },
  {
    title: 'Konvenčný systém',
    desc: 'Pokrytie jednej lokality prevádzačom pre približne 200 účastníkov.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-konvencny-system',
  },
  {
    title: 'Capacity Plus',
    desc: 'Trunkový systém pre rozšírenie kapacity až na 1600 užívateľov v jednej lokalite.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-capacity-plus',
  },
  {
    title: 'IP Site Connect',
    desc: 'Prepojenie až 15 prevádzačov cez IP s automatickým roamingom.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-ip-site-connect',
  },
  {
    title: 'Linked Capacity Plus',
    desc: 'Trunk pre viac ako tisíc užívateľov až v 15 lokalitách.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-linked-capacity-plus',
  },
  {
    title: 'Connect Plus',
    desc: 'Komplexný trunkový systém DMR Tier II s vyhradeným riadiacim kanálom.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-connect-plus',
  },
  {
    title: 'Capacity Max',
    desc: 'Vysoko zabezpečený trunk DMR Tier III pre až 250 lokalít.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-capacity-max',
  },
  {
    title: 'MOTOTRBO ION',
    desc: 'Inteligentná rádiostanica s Androidom, hlas aj širokopásmové dáta.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-ion',
  },
];

// Aplikacie a softver pre MOTOTRBO
const aplikacie = [
  {
    title: 'Funkcie a softvér',
    desc: 'Prevod textu na hlas, potlačenie šumu, šifrovanie, Man Down, pracovné príkazy a ďalšie licencie.',
    href: '/bezpecnostne-systemy-radiove-siete/funkcie-softver-mototrbo',
  },
  {
    title: 'WAVE PTX',
    desc: 'Push-to-talk medzi smartfónmi a rádiostanicami cez IP siete.',
    href: '/bezpecnostne-systemy-radiove-siete/wave-ptx',
  },
  {
    title: 'RDAC',
    desc: 'Diagnostika a diaľkové riadenie prevádzačov.',
    href: '/bezpecnostne-systemy-radiove-siete/mototrbo-rdac',
  },
  {
    title: 'Radio Management a OTAP',
    desc: 'Diaľkové programovanie rádiostaníc „vzduchom" a správa konfigurácií.',
    href: '/bezpecnostne-systemy-radiove-siete/radio-management-otap',
  },
  {
    title: 'SmartPTT',
    desc: 'Dispečerský softvér: hlas, GPS, textové správy a záznam prevádzky.',
    href: '/bezpecnostne-systemy-radiove-siete/smartptt',
  },
  {
    title: 'Rozšírená záruka',
    desc: 'Predĺžená 5-ročná záruka s podporou, opravami aj krytím opotrebenia.',
    href: '/bezpecnostne-systemy-radiove-siete/rozsirena-zaruka',
  },
];

// O prislusenstve MOTOTRBO (preco sa oplatia originalne doplnky Motorola)
const prislusenstvo = [
  {
    title: 'Akumulátory a nabíjačky',
    desc: 'Prečo sa oplatia originálne akumulátory a nabíjačky Motorola.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-akumulatorov-nabijaciek',
  },
  {
    title: 'Energetický systém IMPRES',
    desc: 'Automatická regenerácia akumulátorov a životnosť dlhšia až o 43 %.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-impres',
  },
  {
    title: 'Bezdrôtové príslušenstvo',
    desc: 'Bluetooth OCW príslušenstvo bez káblov, so šifrovaním a diskrétnosťou.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-bezdrotoveho-prislusenstva',
  },
  {
    title: 'Repromikrofóny',
    desc: 'RSM s Windportingom, IMPRES Audio a potlačením hluku (INC).',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-repromikrofonov',
  },
  {
    title: 'Slúchadlá',
    desc: 'Jedno-, dvoj- a trojšnúrové modely pre diskrétnu komunikáciu.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-sluchadiel',
  },
  {
    title: 'Náhlavné súpravy',
    desc: 'Od ultraľahkých po masívne s ochranou sluchu až o 24 dB.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-nahlavnych-suprav',
  },
  {
    title: 'Audiopríslušenstvo IMPRES',
    desc: 'Automatická regulácia zosilnenia a potlačenie hluku pre zrozumiteľnosť.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-audioprislusenstva-impres',
  },
  {
    title: 'Príslušenstvo na nosenie',
    desc: 'Opaskové spony, nylonové a kožené púzdra, popruhy a vodotesné púzdra.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-prislusenstva-na-nosenie',
  },
  {
    title: 'Príslušenstvo pre vozidlá',
    desc: 'Mikrofóny, reproduktory, antény, montáž a kabeláž do vozidiel.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-prislusenstva-pre-vozidlo',
  },
  {
    title: 'Audiopríslušenstvo pre vozidlá',
    desc: 'Mikrofón na clonu, PTT spínače, ručný mikrofón a telefónne slúchadlo.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-audioprislusenstva-pre-vozidlo',
  },
  {
    title: 'Špeciálne príslušenstvo',
    desc: 'Diskrétne súpravy, kostné vedenie a repromikrofóny do extrémneho hluku.',
    href: '/bezpecnostne-systemy-radiove-siete/vyhody-specialneho-prislusenstva',
  },
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-12 md:py-16">
    <nav class="text-sm text-muted mb-2" aria-label="Omrvinky">
      <a class="hover:underline" href="/">Domov</a>
      <span class="px-1">/</span>
      <a class="hover:underline" href="/bezpecnostne-systemy-radiove-siete">Bezpečnostné systémy a rádiové siete</a>
      <span class="px-1">/</span>
      <span class="text-default">Digitálny systém MOTOTRBO</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">Digitálny systém MOTOTRBO</h1>

    <div class="grid items-center gap-8 lg:gap-10 lg:grid-cols-5 mb-12">
      <p class="text-lg text-muted lg:col-span-3">
        MOTOTRBO je profesionálny digitálny rádiový systém na štandarde DMR (Digital Mobile Radio). Prináša spoľahlivú
        komunikáciu, vysokú kvalitu zvuku, bezpečné šifrovanie a pokročilé funkcie, ktoré zefektívňujú každodennú
        prevádzku. RKS riešenia MOTOTRBO navrhuje, dodáva, konfiguruje a servisuje, vrátane kompletnej infraštruktúry.
      </p>
      <div class="lg:col-span-2 aspect-[4/3] overflow-hidden rounded-2xl shadow-sm">
        <Image
          src={heroMototrbo}
          alt="Digitálne rádiostanice Motorola MOTOTRBO"
          widths={[400, 600, 768]}
          sizes="(max-width: 1023px) 100vw, 40vw"
          loading="eager"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <div class="prose prose-lg max-w-none">
      <h2>Hlavné výhody systému MOTOTRBO</h2>
      <ul>
        <li>digitálna kvalita hlasu a vyššia kapacita siete,</li>
        <li>GPS lokalizácia používateľov,</li>
        <li>šifrovanie komunikácie,</li>
        <li>skupinové aj individuálne hovory,</li>
        <li>textové správy a telemetria,</li>
        <li>vzdialená správa zariadení,</li>
        <li>integrácia s dispečerským softvérom.</li>
      </ul>

      <h2>Kde sa MOTOTRBO využíva</h2>
      <p>Výroba, energetika, logistika, doprava, letiská, bezpečnostné služby, priemyselné areály, mestá a obce.</p>

      <h2>Prečo s RKS</h2>
      <p>
        Riešenia MOTOTRBO navrhujeme podľa reálnych prevádzkových potrieb zákazníka, zabezpečujeme projektovanie,
        konfiguráciu, školenie používateľov aj dlhodobý servis. Dodávame, konfigurujeme a servisujeme systémy Motorola
        MOTOTRBO.
      </p>
    </div>

    <h2 class="text-2xl font-semibold tracking-tight mt-14 mb-6">Systémové architektúry MOTOTRBO</h2>
    <p class="text-muted mb-6 max-w-3xl">
      MOTOTRBO je stavebnicový systém. Podľa počtu užívateľov, počtu lokalít a požadovaného pokrytia navrhneme správnu
      architektúru, od najjednoduchšieho priameho spojenia až po rozsiahle trunkové siete.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 mb-4">
      {
        architektury.map((a) => (
          <a
            href={a.href}
            class="block rounded-xl border border-hairline p-5 transition hover:border-primary/40 hover:bg-panel-soft"
          >
            <span class="font-medium text-default">{a.title}</span>
            <span class="mt-1 block text-sm text-muted">{a.desc}</span>
          </a>
        ))
      }
    </div>

    <h2 class="text-2xl font-semibold tracking-tight mt-14 mb-6">Aplikácie a softvér</h2>
    <p class="text-muted mb-6 max-w-3xl">
      Systém MOTOTRBO dopĺňajú aplikácie pre dispečing, správu, diaľkové programovanie a prepojenie so smartfónmi.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 mb-4">
      {
        aplikacie.map((a) => (
          <a
            href={a.href}
            class="block rounded-xl border border-hairline p-5 transition hover:border-primary/40 hover:bg-panel-soft"
          >
            <span class="font-medium text-default">{a.title}</span>
            <span class="mt-1 block text-sm text-muted">{a.desc}</span>
          </a>
        ))
      }
    </div>

    <h2 class="text-2xl font-semibold tracking-tight mt-14 mb-6">O príslušenstve</h2>
    <p class="text-muted mb-6 max-w-3xl">
      Spoľahlivosť rádiostanice závisí aj od príslušenstva. Prečo sa oplatia originálne akumulátory, audiopríslušenstvo
      a doplnky Motorola vysvetľujú nasledujúce články.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 mb-4">
      {
        prislusenstvo.map((a) => (
          <a
            href={a.href}
            class="block rounded-xl border border-hairline p-5 transition hover:border-primary/40 hover:bg-panel-soft"
          >
            <span class="font-medium text-default">{a.title}</span>
            <span class="mt-1 block text-sm text-muted">{a.desc}</span>
          </a>
        ))
      }
    </div>

    <h2 class="text-2xl font-semibold tracking-tight mt-14 mb-6">Katalóg produktov</h2>
    <p class="text-muted mb-6 max-w-3xl">
      Kompletný katalóg rádiostaníc MOTOTRBO, prevádzačov a príslušenstva s parametrami, filtrami a servisnými
      informáciami.
    </p>
    <a
      href="/katalog-produktov/kategoria/radiostanice"
      class="inline-flex items-center gap-2 rounded-xl border border-primary/30 bg-primary/5 px-5 py-3 font-medium text-primary transition hover:bg-primary/10"
      >Prejsť na katalóg rádiostaníc MOTOTRBO &rarr;</a
    >

    <h2 class="text-2xl font-semibold tracking-tight mt-14 mb-6">Časté otázky</h2>
    <div class="space-y-4">
      {
        faqs.map((faq) => (
          <details class="group rounded-xl border border-hairline p-5">
            <summary class="cursor-pointer list-none font-medium marker:hidden flex justify-between items-center gap-4">
              {faq.q}
              <span class="text-primary transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="text-muted mt-3">{faq.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-14 rounded-2xl bg-primary/5 border border-primary/20 p-8 text-center">
      <h2 class="text-xl md:text-2xl font-semibold mb-3">Zaujíma vás digitálny systém MOTOTRBO?</h2>
      <p class="text-muted mb-6 max-w-xl mx-auto">
        Pripravíme návrh riešenia pre vašu organizáciu. Pozrite si aj
        <a class="text-primary hover:underline" href="/bezpecnostne-systemy-radiove-siete/mototrbo"
          >konkrétne zariadenia a modely →</a
        >
      </p>
      <a href="/lp/konzultacia.html?utm_source=web&utm_campaign=web" class="btn-primary inline-flex"
        >Dohodnúť nezáväznú konzultáciu</a
      >
    </div>
  </section>
</Layout>
