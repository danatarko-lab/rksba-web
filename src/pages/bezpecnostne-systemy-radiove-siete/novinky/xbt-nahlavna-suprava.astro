---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'XBT náhlavná súprava | Novinky MOTOTRBO | RKS',
  description:
    'Pri práci v prostredí s vysokou hladinou hluku užívatelia potrebujú chrániť svoj sluch chráničmi sluchu, ale súčasne musia byť schopní komunikovať s ostatnými. Tieto nároky spĺňajú XBT bezdrôtové…',
};

const post = {
  title: 'XBT náhlavná súprava',
  date: '18. 10. 2014',
};

const body =
  '<p><a href="/bezpecnostne-systemy-radiove-siete/novinky/xbt-nahlavna-suprava"></a></p>\n<p><img src="/images/novinky/XBT_Heavy_Duty_Headset.jpg" alt="XBT Heavy Duty Headset" loading="lazy" decoding="async"></p>\n<p>Pri práci v prostredí s vysokou hladinou hluku užívatelia potrebujú chrániť svoj sluch chráničmi sluchu, ale súčasne musia byť schopní komunikovať s ostatnými. Tieto nároky spĺňajú XBT bezdrôtové náhlavne súpravy s rozhraním Bluetooth a patentovanou SENS™ technológiu, ktorá kombinuje pokročilé zvýraznenie reči s extrémným potlačením okolitého hluku.</p>\r\n<p>Zabudovaný mikrofón vám umožní počuť zvuky okolo vás, a rozpoznáva reč, takže pri nosení náhlavnej súpravy môžete počuť, čo hovoria iní. To znamená, že náhlavná súprava poskytuje ochranu pred silným hlukom, ale stále umožňuje užívateľovi počúvať rádiovú komunikáciu, aj to, čo sa deje okolo neho.</p>\r\n<p><a href="/katalog-produktov/rln6490">RLN6490</a> má hlavový most umiestnený na zátylku, čo ju umožňuje nosiť pod prilbou.</p>\r\n<p><a href="/katalog-produktov/rln6491">RLN6491</a> má hlavový most umiestnený na temene.</p>\r\n<p><video controls="controls">\r\n<source src="images/videos/MOTOTRBO_XBT_Wireless_Headset.mp4" type="video/mp4" /></video></p>';
---

<Layout metadata={metadata}>
  <nav class="mx-auto max-w-3xl px-4 sm:px-6 pt-6 text-sm text-muted" aria-label="Omrvinky">
    <a class="hover:underline" href="/">Domov</a>
    <span class="px-1">/</span>
    <a class="hover:underline" href="/bezpecnostne-systemy-radiove-siete">Bezpečnostné systémy a rádiové siete</a>
    <span class="px-1">/</span>
    <a class="hover:underline" href="/bezpecnostne-systemy-radiove-siete/novinky">Novinky MOTOTRBO</a>
    <span class="px-1">/</span>
    <span class="text-default">{post.title}</span>
  </nav>

  <div class="bg-gradient-to-br from-[#0A2342] via-[#13234D] to-primary text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-12 md:py-16">
      <p class="text-xs font-semibold tracking-widest text-accent uppercase mb-3">Novinky MOTOTRBO</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight">{post.title}</h1>
      <p class="mt-4 text-sm text-white/70">{post.date}</p>
    </div>
  </div>

  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-12 md:py-16">
    <div class="prose prose-lg max-w-none rks-novinka" set:html={body} />

    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-hairline pt-8 text-sm">
      <a class="font-medium text-primary hover:underline" href="/bezpecnostne-systemy-radiove-siete/novinky"
        >&larr; Všetky novinky</a
      >
      <a class="font-medium text-primary hover:underline" href="/katalog-produktov">Katalóg produktov &rarr;</a>
    </div>
  </article>
</Layout>

<style>
  .rks-novinka :global(img) {
    height: auto;
    max-width: 100%;
    border-radius: 0.5rem;
  }
  .rks-novinka :global(table) {
    width: 100%;
    font-size: 0.95rem;
  }
</style>
