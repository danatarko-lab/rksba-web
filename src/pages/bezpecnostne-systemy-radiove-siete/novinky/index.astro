---
import Layout from '~/layouts/PageLayout.astro';
import { novinky } from '~/data/novinky';

const metadata = {
  title: 'Novinky MOTOTRBO | RKS',
  description:
    'Novinky o rádiostaniciach a systémoch Motorola MOTOTRBO: nové modely, firmvér, príslušenstvo a zmeny v ponuke. Archív z rokov 2012 az 2021.',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-12 md:py-16">
    <nav class="text-sm text-muted mb-2" aria-label="Omrvinky">
      <a class="hover:underline" href="/">Domov</a>
      <span class="px-1">/</span>
      <a class="hover:underline" href="/bezpecnostne-systemy-radiove-siete">Bezpečnostné systémy a rádiové siete</a>
      <span class="px-1">/</span>
      <span class="text-default">Novinky MOTOTRBO</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">Novinky MOTOTRBO</h1>
    <p class="text-lg text-muted mb-10 max-w-3xl">
      Nové modely, firmvér, príslušenstvo a zmeny v ponuke Motorola MOTOTRBO. Archív článkov z mototrbo.sk z rokov 2012
      až 2021.
    </p>

    <div class="grid gap-6">
      {
        novinky.map((post) => (
          <a
            href={post.href}
            class="group flex flex-col sm:flex-row gap-5 rounded-2xl border border-hairline bg-panel p-5 transition duration-200 hover:-translate-y-1 hover:border-primary hover:shadow-lg"
          >
            <div class="shrink-0 sm:w-44">
              {post.image ? (
                <img
                  src={post.image}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-32 w-full sm:h-28 rounded-xl object-contain bg-panel-soft p-2"
                />
              ) : (
                <div class="flex h-32 sm:h-28 w-full items-center justify-center rounded-xl bg-gradient-to-br from-[#0A2342] via-[#13234D] to-primary">
                  <span class="text-xs font-semibold uppercase tracking-widest text-white/80">MOTOTRBO</span>
                </div>
              )}
            </div>
            <div class="min-w-0">
              <p class="text-xs font-semibold tracking-widest text-muted uppercase mb-1">{post.date}</p>
              <h2 class="text-lg md:text-xl font-semibold tracking-tight leading-snug mb-2">{post.title}</h2>
              <p class="text-muted text-sm line-clamp-3">{post.excerpt}</p>
              <span class="mt-3 inline-flex text-sm font-medium text-primary group-hover:underline">
                Čítať <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
