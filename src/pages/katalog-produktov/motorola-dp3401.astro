const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Produkty",
        "item": "https://rksba.sk/produkty"
      },
      {
