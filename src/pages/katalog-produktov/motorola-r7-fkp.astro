          } else if (d.dataset.rksAuto === '1') {
            d.open = false;
            d.dataset.rksAuto = '';
          }
        });
      }
      sync();
      if (mq.addEventListener) mq.addEventListener('change', sync);
      else if (mq.addListener) mq.addListener(sync);
      document.addEventListener('astro:page-load', sync);
    })();
  </script>

