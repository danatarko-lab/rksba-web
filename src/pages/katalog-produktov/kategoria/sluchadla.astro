        "pocet": 40
      },
      {
        "hodnota": "Nie",
        "pocet": 16
      },
      {
        "hodnota": "Na samostatnom kábliku",
        "pocet": 10
      },
      {
        "hodnota": "Na kábliku",
        "pocet": 5
      },
      {
        "hodnota": "Na adaptéri PMLN6368",
        "pocet": 1
      }
    ]
  },
  {
    "key": "prevedenie",
    "nazov": "Prevedenie",
    "hodnoty": [
      {
        "hodnota": "1-šnúrové",
        "pocet": 39
      },
      {
        "hodnota": "2-šnúrové",
        "pocet": 23
      },
      {
        "hodnota": "3-šnúrové",
        "pocet": 10
      }
    ]
  },
  {
    "key": "programovatelne-tlacidlo",
    "nazov": "Programovateľné tlačidlo",
    "hodnoty": [
      {
        "hodnota": "Nie",
        "pocet": 53
      },
      {
        "hodnota": "Áno",
        "pocet": 19
      }
    ]
  },
  {
    "key": "rezim",
    "nazov": "Režim",
    "hodnoty": [
      {
        "hodnota": "Príjem cez jedno slúchadlo / Vysielanie",
        "pocet": 55
      },
      {
        "hodnota": "Len príjem",
        "pocet": 15
      },
      {
        "hodnota": "Príjem cez obe slúchadlá / Vysielanie",
        "pocet": 2
      }
    ]
  },
  {
    "key": "vox",
    "nazov": "VOX",
    "hodnoty": [
      {
