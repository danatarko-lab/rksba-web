  },
  {
    "name": "Mikrofónne stanice",
    "url": null
  }
];
const heading = "Mikrofónne stanice";
const popisHtml = "";
const intro = [];
const subcats = [];
const subcatsHeading = "";
const products = [
  {
    "url": "/katalog-produktov/rm-200m",
    "img": "/images/katalog-produktov/614/main.webp",
    "title": "RM-200M",
    "desc": "Mikrofónna stanica"
  },
  {
    "url": "/katalog-produktov/rm-210",
    "img": "/images/katalog-produktov/615/main.webp",
    "title": "RM-210",
    "desc": "Klávesnica pre mikrofónnu stanicu"
  },
  {
    "url": "/katalog-produktov/rm-300mf",
    "img": "/images/katalog-produktov/616/main.webp",
