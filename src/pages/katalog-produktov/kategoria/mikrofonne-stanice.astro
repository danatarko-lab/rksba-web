-children pl-3 mt-1 space-y-1 border-l border-hairline\"><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/ine-prevadzace\" class=\"rks-link text-default hover:text-link\">Iné príslušenstvo (Prevádzače)<span class=\"text-muted text-xs ml-2\">3</span></a></li><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/softver\" class=\"rks-link text-default hover:text-link\">Softvér (Prevádzače)<span class=\"text-muted text-xs ml-2\">10</span></a></li></ul></li><li class=\"rks-li\"><a href=\"/katalog-produktov/kategoria/vozidlove-radiostanice\" class=\"rks-link text-default hover:text-link\">Vozidlové rádiostanice<span class=\"text-muted text-xs ml-2\">37</span></a><details class=\"rks-disc\"><summary class=\"rks-arrow\" aria-label=\"Rozbaliť\"></summary></details><ul class=\"rks-children pl-3 mt-1 space-y-1 border-l border-hairline\"><li class=\"rks-li\"><a href=\"/katalog-produktov/kategoria/zakladnove-komercne\" class=\"rks-link text-default hover:text-link\">Komerčné rádiostanice<span class=\"text-muted text-xs ml-2\">26</span></a><details class=\"rks-disc\"><summary class=\"rks-arrow\" aria-label=\"Rozbaliť\"></summary></details><ul class=\"rks-children pl-3 mt-1 space-y-1 border-l border-hairline\"><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/anteny-cm\" class=\"rks-link text-default hover:text-link\">Antény (CM)<span class=\"text-muted text-xs ml-2\">5</span></a></li><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/ine-prislusenstvo-cm\" class=\"rks-link text-default hover:text-link\">Iné príslušenstvo (CM)<span class=\"text-muted text-xs ml-2\">3</span></a></li><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/instalacia-cm\" class=\"rks-link text-default hover:text-link\">Inštalácia (CM)<span class=\"text-muted text-xs ml-2\">7</span></a></li><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/mikrofony-cm\" class=\"rks-link text-default hover:text-link\">Mikrofóny (CM)<span class=\"text-muted text-xs ml-2\">5</span></a></li><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/reproduktory-cm\" class=\"rks-link text-default hover:text-link\">Reproduktory (CM)<span class=\"text-muted text-xs ml-2\">2</span></a></li></ul></li><li class=\"rks-li\"><a href=\"/katalog-produktov/kategoria/zakladnove-profesionalne\" class=\"rks-link text-default hover:text-link\">Profesionálne rádiostanice<span class=\"text-muted text-xs ml-2\">11</span></a><details class=\"rks-disc\"><summary class=\"rks-arrow\" aria-label=\"Rozbaliť\"></summary></details><ul class=\"rks-children pl-3 mt-1 space-y-1 border-l border-hairline\"><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/instalacia-gm\" class=\"rks-link text-default hover:text-link\">Inštalácia (GM)<span class=\"text-muted text-xs ml-2\">2</span></a></li><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/mikrofony-gm\" class=\"rks-link text-default hover:text-link\">Mikrofóny (GM)<span class=\"text-muted text-xs ml-2\">3</span></a></li></ul></li></ul></li><li class=\"rks-li\"><a href=\"/katalog-produktov/kategoria/vozidlove-radiostanice-analogove-vx\" class=\"rks-link text-default hover:text-link\">Vozidlové rádiostanice analógové VX<span class=\"text-muted text-xs ml-2\">7</span></a><details class=\"rks-disc\"><summary class=\"rks-arrow\" aria-label=\"Rozbaliť\"></summary></details><ul class=\"rks-children pl-3 mt-1 space-y-1 border-l border-hairline\"><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/mikrofony-vx\" class=\"rks-link text-default hover:text-link\">Mikrofóny (VX)<span class=\"text-muted text-xs ml-2\">3</span></a></li><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/reproduktory-vx\" class=\"rks-link text-default hover:text-link\">Reproduktory (VX)<span class=\"text-muted text-xs ml-2\">2</span></a></li></ul></li></ul></li><li class=\"rks-li\"><a href=\"/katalog-produktov/kategoria/varovacie-a-vyrozumievacie-systemy\" class=\"rks-link text-default hover:text-link\">Varovacie a vyrozumievacie systémy<span class=\"text-muted text-xs ml-2\">5</span></a><details class=\"rks-disc\"><summary class=\"rks-arrow\" aria-label=\"Rozbaliť\"></summary></details><ul class=\"rks-children pl-3 mt-1 space-y-1 border-l border-hairline\"><li class=\"rks-leaf\"><a href=\"/katalog-produktov/kategoria/elektronicke-sireny\" class=\"rks-link text-default hover:text-link\">Elektronické sirény<span class=\"text-muted text-xs ml-2\">5</span></a></li></ul></li></ul></nav>";
const breadcrumb = [
  {
    "name": "Produkty",
