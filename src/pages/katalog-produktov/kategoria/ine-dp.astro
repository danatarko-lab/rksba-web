const metadata = {
  "title": "Iné, katalóg produktov | RKS",
  "description": "Iné príslušenstvo pre prenosné profesionálne digitálne rádiostanice rady Mototrbo   V tejto kategórii nájdete doplnkové príslušenstvo pre prenosné digitálne rádiostanice MOTOTRBO rady DP, ktoré nepatrí do ostatných kategórií — od praktických doplnkov po špecifické diely podľa prevádzky.",
