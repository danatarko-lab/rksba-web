                        <span class="flex-1">{v.hodnota}</span>
                        <span class="text-muted text-xs tabular-nums" data-rks-cnt>{v.pocet}</span>
                      </label>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </details>
        )}
