---
/*
  Rozcestník — samostatná vstupná brána (front door) na testovacej adrese.
  Nepoužíva PageLayout ani mega-menu, beží na minimálnom SplashLayout.
  Vnútorné stránky webu sa týmto nemenia.
*/
import { Image } from 'astro:assets';

import SplashLayout from '~/layouts/SplashLayout.astro';

import logo from '~/assets/images/rks-logo-short.png';
import radiokomunikacie from '~/assets/images/rozcestnik/radiokomunikacie-hala.jpg';
import energetika from '~/assets/images/rozcestnik/energetika-fotovoltika.jpg';

const panely = [
  {
    href: '/radiokomunikacie',
    image: radiokomunikacie,
    // Siréna je v ľavej hornej štvrtine, robotník vpravo — tento výrez udrží oboch.
    position: '50% 40%',
    alt: 'Robotník s vysielačkou vo výrobnej hale, na stĺpe siréna evakuačného rozhlasu',
    title: 'Bezpečnosť a rádiokomunikácie',
    text: 'Profesionálne rádiové siete, autonómne systémy varovania a evakuačný rozhlas pre priemysel a kritickú infraštruktúru.',
  },
  {
    href: '/energetika',
    image: energetika,
    /*
      Technik je v origináli na ~63 % šírky. Pri zadanom 62 % ho výrez posunie
      na ~63 % šírky panela, teda presne za stredový box (ten zaberá 30–70 %) —
      zakryje mu trup aj tablet. 25 % ho posunie na ~75 %, voľne vedľa boxu.
    */
    position: '25% center',
    alt: 'Technik s tabletom kontroluje fotovoltické panely na streche priemyselnej haly',
    title: 'Firemná energetika',
    text: 'Meranie spotreby, optimalizácia nákladov, fotovoltika a batériové úložiská s overenou návratnosťou.',
  },
];
---

<SplashLayout
  title="RKS — bezpečnostné systémy, rádiokomunikácie a firemná energetika"
  description="Vyberte si oblasť: bezpečnosť a rádiokomunikácie, alebo firemná energetika."
>
  <div class="splash">
    <header class="bar">
      <a class="brand" href="/" aria-label="RKS — domov">
        <img src={logo.src} width={logo.width} height={logo.height} alt="RKS" loading="eager" decoding="async" />
      </a>
      <span class="lang">SK</span>
    </header>

    <main class="panels">
      {
        panely.map((p) => (
          <a class="panel" href={p.href}>
            <Image
              class="photo"
              src={p.image}
              alt={p.alt}
              width={1200}
              format="webp"
              quality={78}
              loading="eager"
              style={`object-position: ${p.position};`}
            />
            <span class="overlay" />
            <span class="box">
              <span class="box-title">{p.title}</span>
              <span class="box-text">{p.text}</span>
              <span class="btn">Vstúpiť</span>
            </span>
          </a>
        ))
      }
    </main>

    <footer class="foot">
      <p>R K S, spol. s r.o. · Technológie, ktoré držia spojenie · Od roku 1991</p>
    </footer>
  </div>
</SplashLayout>

<style>
  .splash {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  /* Horná lišta — rovnaká svetlomodrá ako hlavička webu. */
  .bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: #eaf2ff;
    border-bottom: 1px solid rgba(10, 35, 66, 0.1);
    padding: 12px 24px;
  }
  .brand {
    display: inline-flex;
  }
  .brand img {
    height: 30px;
    width: auto;
  }
  .lang {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #5b6472;
  }

  .panels {
    flex: 1;
    display: flex;
    min-height: 0;
  }

  .panel {
    flex: 1;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    padding: 40px 26px;
  }
  .panel + .panel {
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .panel:hover .photo,
  .panel:focus-visible .photo {
    transform: scale(1.04);
  }

  /* Jemné stmavenie kvôli čitateľnosti boxu. */
  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 35, 66, 0.22), rgba(10, 35, 66, 0.5));
  }

  .box {
    position: relative;
    display: block;
    max-width: 380px;
    padding: 30px 32px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
  }
  .box-title {
    display: block;
    margin-bottom: 10px;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #0a2342;
  }
  .box-text {
    display: block;
    margin-bottom: 22px;
    font-size: 15px;
    line-height: 1.55;
    color: #41556b;
  }

  .btn {
    display: inline-block;
    padding: 12px 28px;
    border-radius: 8px;
    background: #0000ff;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    transition: background-color 0.2s ease;
  }
  .panel:hover .btn,
  .panel:focus-visible .btn {
    background: #0161ef;
  }

  .panel:focus-visible {
    outline: 3px solid #eaf2ff;
    outline-offset: -6px;
  }

  /* Pätička — rovnaká sivá ako pätička webu. */
  .foot {
    flex: none;
    background: #5d6c7b;
    color: #fff;
    text-align: center;
    padding: 20px 16px;
  }
  .foot p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .panels {
      flex-direction: column;
    }
    .panel {
      /*
        Zámerne nie svh — dva panely po 44svh plus lišta a pätička presiahnu
        okno a brána sa začne rolovať. Takto si panely rozdelia zvyšok presne
        a pevné minimum drží obsah čitateľný len na veľmi nízkych displejoch.
      */
      min-height: 220px;
      padding: 36px 20px;
    }
    .panel + .panel {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
    }
    .box-title {
      font-size: 22px;
    }
    .box {
      padding: 24px 22px;
    }
  }

  /* Úzke displeje: bez stiahnutých odsadení by brána presiahla výšku okna. */
  @media (max-width: 380px) {
    .panel {
      padding: 24px 16px;
    }
    .box {
      padding: 20px 18px;
    }
    .box-text {
      margin-bottom: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo,
    .btn {
      transition: none;
    }
    .panel:hover .photo,
    .panel:focus-visible .photo {
      transform: none;
    }
  }
</style>
