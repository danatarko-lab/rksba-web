---
import Layout from '~/layouts/PageLayout.astro';
import { caseStudies, caseStudiesTotal } from '~/data/pripadove-studie';

// Docasne noindex, nofollow: obsah je preneseny z mototrbo.sk a cely presun
// zatial nie je dokonceny. Stranka nie je redirect-stub, takze robots si musi
// nastavit sama.
const metadata = {
  title: 'Prípadové štúdie MOTOTRBO | RKS',
  description:
    'Výber reprezentatívnych prípadových štúdií nasadení systému MOTOTRBO z celého sveta, rozdelený podľa odvetví.',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 md:py-16">
    <nav class="text-sm text-muted mb-2" aria-label="Omrvinky">
      <a class="hover:underline" href="/">Domov</a>
      <span class="px-1">/</span>
      <a class="hover:underline" href="/bezpecnostne-systemy-radiove-siete">Bezpečnostné systémy a rádiové siete</a>
      <span class="px-1">/</span>
      <span class="text-default">Prípadové štúdie</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">Prípadové štúdie</h1>

    <p class="text-lg text-muted max-w-3xl">
      Možnosti systému MOTOTRBO sa najlepšie ukážu na konkrétnych príkladoch. Nižšie nájdete výber reprezentatívnych
      prípadových štúdií z celého sveta: riešenia, ktoré Motorola realizovala so svojimi partnermi.
    </p>

    <p class="text-sm text-muted mt-3">
      {caseStudiesTotal} štúdií v {caseStudies.length} odvetviach. Každá sa otvorí ako PDF v novej záložke.
    </p>

    <!-- Rychla navigacia: pri 17 kategoriach je skakanie na odvetvie rychlejsie ako skrolovanie. -->
    <nav class="mt-8 flex flex-wrap gap-2" aria-label="Odvetvia">
      {
        caseStudies.map((cat) => (
          <a
            class="rounded-full border border-hairline bg-panel-soft px-3 py-1.5 text-sm text-muted transition hover:border-primary hover:text-default"
            href={`#${cat.slug}`}
          >
            {cat.label} <span class="text-muted">({cat.items.length})</span>
          </a>
        ))
      }
    </nav>

    {
      caseStudies.map((cat) => (
        <section class="mt-12 scroll-mt-24" id={cat.slug}>
          <h2 class="border-b border-hairline pb-2 text-xl md:text-2xl font-semibold tracking-tight text-heading">
            {cat.label}
            <span class="ml-2 text-base font-normal text-muted">({cat.items.length})</span>
          </h2>

          <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {cat.items.map((item) => (
              <li>
                <a
                  class="group flex h-full gap-4 rounded-xl border border-hairline bg-panel p-4 transition hover:-translate-y-1 hover:border-primary hover:shadow-lg"
                  href={`/pripadove-studie/${item.file}`}
                  target="_blank"
                  rel="noopener"
                >
                  <img
                    src={`/pripadove-studie/${item.thumb}`}
                    alt={`Náhľad prvej strany: ${item.title}`}
                    width="73"
                    height="102"
                    loading="lazy"
                    decoding="async"
                    class="h-[102px] w-[73px] shrink-0 rounded border border-hairline object-cover"
                  />
                  <span class="flex flex-col">
                    <span class="font-medium text-heading group-hover:underline">{item.title}</span>
                    <span class="mt-1 text-sm text-muted">PDF</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Layout>
